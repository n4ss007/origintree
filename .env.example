# Copy to .env and fill in. Never commit the filled-in file — .env is ignored.
#
#   cp .env.example .env
#
# Nothing here is required to browse the site, but the NCBI lookups that make
# it useful need a contact address.


# --- NCBI -------------------------------------------------------------------

# Required. NCBI asks every programmatic caller to identify itself and the API
# refuses to start a lookup without this, rather than sending a placeholder.
NCBI_EMAIL=

# Optional locally, worth having in production. Raises NCBI's ceiling from 3 to
# 10 requests a second and counts them against the key rather than the server's
# outbound address — which on a hosting platform is shared with everyone else
# on it. Free from https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# Seconds before an outbound NCBI call gives up. Default 15.
ORIGINTREE_NCBI_TIMEOUT=


# --- Serving ----------------------------------------------------------------

# Comma-separated origins allowed to call the API. Defaults to the local
# development hosts, so a deployment must name its own domain here.
ORIGINTREE_ALLOWED_ORIGINS=

# Where the site lives. Defaults to ../frontend relative to the backend.
ORIGINTREE_FRONTEND_DIR=

# Set to 1 only once the site is genuinely served over HTTPS: it sends HSTS,
# which tells browsers to refuse plain HTTP for a year.
ORIGINTREE_HTTPS=

# Set to off to withdraw /docs, /redoc and /openapi.json from a deployment.
ORIGINTREE_DOCS=


# --- Limits -----------------------------------------------------------------

# API requests allowed per client address per window. Defaults: 60 per 60s.
ORIGINTREE_RATE_LIMIT=
ORIGINTREE_RATE_WINDOW=


# --- Data -------------------------------------------------------------------

# Path to the fossil calibration set. Defaults to data/fossils.csv.
ORIGINTREE_FOSSIL_FILE=
